dist/
# The embedded UI directory must exist in a fresh clone: ui/ui.go embeds it with
# //go:embed all:dist, which fails to compile when the directory is missing. Only
# the placeholder is tracked; the built assets stay ignored.
!ui/dist/
ui/dist/*
!ui/dist/.gitkeep
test-results/
.env
.env.*
coverage/
bin/
*.log
.DS_Store

coverage.out
.slim/deepwork/
ui/.tanstack/

# Nix build output and per-user garbage collection roots.
result
result-*
