{
  "name": "teldrive-ui",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "generate:api": "bunx openapi-typescript@7.13.0 ../openapi/teldrive.openapi.yaml -o ./src/api/schema.ts",
    "lint": "biome lint src e2e",
    "format": "biome format --write src",
    "typecheck": "tsc",
    "test": "playwright test e2e/core.spec.ts e2e/file-manager.spec.ts e2e/viewers.spec.ts e2e/source-audit.spec.ts e2e/i18n.spec.ts e2e/theme.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint:fix": "biome lint --write --unsafe src e2e"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@vplayer/react": "^0.2.4",
    "foliate-js": "github:johnfactotum/foliate-js#399248a67a8862ffb5e6463a33f9d52b317ca2eb",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "pdfjs-dist": "^6.4.299",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.22.0",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "overrides": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@iconify-json/gravity-ui": "^1.2.14",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/icon-park-outline": "^1.2.4",
    "@iconify-json/ion": "^1.2.7",
    "@iconify-json/material-symbols": "^1.2.94",
    "@playwright/test": "^1.64.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.6",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "fflate": "^0.8.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.3.3"
  }
}
