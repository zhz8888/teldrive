---
import DocsPage from '../components/DocsPage.astro';
import { getLocaleSource } from '../lib/source';
import { defaultLocale } from '../lib/i18n';

export async function getStaticPaths() {
  const { source } = await getLocaleSource(defaultLocale);
  return source.getPages().map((page) => ({
    params: { slug: page.slugs.length > 0 ? page.slugs.join('/') : undefined },
    props: { page: page.data._raw },
  }));
}

const { page } = Astro.props;
---

<DocsPage page={page} locale={defaultLocale} />
