---
import DocsPage from '../../components/DocsPage.astro';
import { getLocaleSource } from '../../lib/source';
import { locales } from '../../lib/i18n';

// getStaticPaths renders one page per entry of the Chinese tree under /zh; the
// slug segments become the route path and the raw entry is handed to DocsPage.
export async function getStaticPaths() {
  const { source } = await getLocaleSource(locales.zh.code);
  return source.getPages().map((page) => ({
    params: { slug: page.slugs.length > 0 ? page.slugs.join('/') : undefined },
    props: { page: page.data._raw },
  }));
}

const { page } = Astro.props;
---

<DocsPage page={page} locale={locales.zh.code} />
