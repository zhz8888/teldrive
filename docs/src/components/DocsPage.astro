---
import { render, type CollectionEntry } from 'astro:content';
import { Docs } from './docs';
import { getMdxComponents } from './mdx';
import '../styles/global.css';
import { getLocaleSource, localizedTree, localizedURL } from '../lib/source';
import { getPageImageUrl } from '../lib/shared';
import Layout from './layout.astro';
import type { LocaleCode } from '../lib/i18n';
import type { TOCItemType } from 'fumadocs-core/toc';
import { findNeighbour } from 'fumadocs-core/page-tree';

interface Props {
  /** The documentation entry this page renders. */
  page: CollectionEntry<'docs'>;
  /** Locale the page is served in, which selects the tree and translations. */
  locale: LocaleCode;
}

const { page, locale } = Astro.props;

// The locale's own page tree, so navigation stays inside one language. The
// sidebar needs the localized URLs: the bare tree keeps the English paths, and
// its pages are what the neighbour lookup below matches against.
const { source, tree } = await getLocaleSource(locale);
const sidebarTree = localizedTree(locale);
// The compiled MDX body and the headings that become the table of contents.
const { Content, headings } = await render(page);
const mdxComponents = getMdxComponents(locale);

// Slug segments of the request, which identify the page inside the tree.
const slugs = typeof Astro.params.slug === 'string' ? Astro.params.slug.split('/') : [];
const docsPage = source.getPage(slugs)!;
// Social preview image for this page, resolved per locale.
const image = getPageImageUrl(docsPage, locale).url;

// Adjacent pages in tree order; the footer links to them.
const neighbours = findNeighbour(tree, docsPage.url);
// withLocale rewrites a neighbour's URL so it points at the current locale.
const withLocale = <T extends { url: string } | undefined>(item: T): T => {
  if (item === undefined) return item;
  return { ...item, url: localizedURL(locale, item.url) } as T;
};

// Source path inside the repository, needed for the "edit this page" link.
const sourceFile = slugs.length > 0 ? `${slugs.join('/')}.mdx` : 'index.mdx';
const editUrl = `https://github.com/zhz8888/teldrive/edit/v2/docs/content/docs/${locale}/${sourceFile}`;

// The heading list the layout renders next to the article.
const toc: TOCItemType[] = headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: '#' + heading.slug,
}));

// Drives the document language and the wording of the edit link.
const isChinese = locale === 'zh';
---

<Layout lang={isChinese ? 'zh-CN' : 'en'}>
  <title>{page.data.title}</title>
  <meta name="title" content={page.data.title} />
  <meta name="description" content={page.data.description} />
  <meta property="og:image" content={image} />
  <Docs
    tree={sidebarTree}
    pathname={Astro.url.pathname}
    params={Astro.params}
    locale={locale}
    page={{ toc, footer: { items: { prev: withLocale(neighbours[0]), next: withLocale(neighbours[1]) } } }}
    client:load
  >
    <h1 class="font-semibold text-3xl">{page.data.title}</h1>
    <p class="text-lg text-fd-muted-foreground mb-8">{page.data.description}</p>
    <div class="prose flex-1">
      <Content components={mdxComponents} />
    </div>
    <div class="mt-10 border-t pt-6 text-sm text-fd-muted-foreground">
      <a class="hover:text-fd-foreground hover:underline" href={editUrl}>
        {isChinese ? '在 GitHub 上编辑此页' : 'Edit this page on GitHub'}
      </a>
    </div>
  </Docs>
</Layout>
